{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release-check-data.schema.json",
  "title": "Codex Game Atelier read-only release check data",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "selected_mode", "release_ready", "checks", "counts"],
  "properties": {
    "scope": { "const": "project-release" },
    "selected_mode": { "type": "string", "enum": ["", "manual", "standard", "strict"] },
    "project_mode": { "type": "string", "enum": ["manual", "standard", "strict"] },
    "project_revision": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "release_ready": { "type": "boolean" },
    "checks": {
      "type": "array",
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome", "summary"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "outcome": { "type": "string", "enum": ["PASS", "BLOCKED", "NOT_RUN"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "blocked", "not_run"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0, "maximum": 11 },
        "blocked": { "type": "integer", "minimum": 0, "maximum": 11 },
        "not_run": { "type": "integer", "minimum": 0, "maximum": 11 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "release_ready": { "const": true } }, "required": ["release_ready"] },
      "then": {
        "properties": {
          "selected_mode": { "const": "strict" },
          "counts": {
            "properties": {
              "blocked": { "const": 0 },
              "not_run": { "const": 0 }
            }
          }
        },
        "required": ["project_mode", "project_revision"]
      }
    }
  ]
}
