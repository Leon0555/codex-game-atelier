{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-result.schema.json",
  "title": "Codex Game Atelier command result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "command", "outcome", "started_at", "finished_at", "duration_ms", "exit_code", "summary", "errors", "evidence", "data"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "run_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "arguments"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?: [a-z][a-z0-9-]*)*$" },
        "arguments": { "type": "object", "additionalProperties": true }
      }
    },
    "outcome": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED"]
    },
    "started_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "finished_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "errors": {
      "type": "array",
      "items": { "$ref": "error.schema.json" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/evidenceRef" }
    },
    "data": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "enum": ["PASS", "SKIPPED"] } }, "required": ["outcome"] },
      "then": {
        "properties": {
          "exit_code": { "const": 0 },
          "errors": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "BLOCKED" } }, "required": ["outcome"] },
      "then": {
        "properties": {
          "exit_code": { "const": 4 },
          "errors": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "FAIL" } }, "required": ["outcome"] },
      "then": {
        "properties": {
          "exit_code": { "enum": [2, 3, 5, 6, 7, 8] },
          "errors": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "command": { "properties": { "name": { "const": "detect" } }, "required": ["name"] }, "exit_code": { "not": { "const": 2 } } }, "required": ["command", "exit_code"] },
      "then": { "properties": { "data": { "$ref": "detect-data.schema.json" } } }
    },
    {
      "if": { "properties": { "command": { "properties": { "name": { "const": "doctor" } }, "required": ["name"] }, "exit_code": { "not": { "const": 2 } } }, "required": ["command", "exit_code"] },
      "then": { "properties": { "data": { "$ref": "doctor-data.schema.json" } } }
    },
    {
      "if": { "properties": { "command": { "properties": { "name": { "const": "initialize" } }, "required": ["name"] }, "exit_code": { "not": { "const": 2 } } }, "required": ["command", "exit_code"] },
      "then": { "properties": { "data": { "$ref": "initialize-data.schema.json" } } }
    },
    {
      "if": { "properties": { "command": { "properties": { "name": { "const": "status" } }, "required": ["name"] }, "exit_code": { "not": { "const": 2 } } }, "required": ["command", "exit_code"] },
      "then": { "properties": { "data": { "$ref": "status-data.schema.json" } } }
    }
  ]
}
