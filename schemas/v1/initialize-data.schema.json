{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "initialize-data.schema.json",
  "title": "Codex Game Atelier initialize data",
  "type": "object",
  "additionalProperties": false,
  "required": ["initialized", "created", "state_path"],
  "properties": {
    "initialized": { "type": "boolean" },
    "created": { "type": "boolean" },
    "state_path": { "const": ".gameatelier/project.json" },
    "project_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "revision": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "mode": { "type": "string", "enum": ["manual", "standard", "strict"] },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requested_version", "language"],
      "properties": {
        "kind": { "const": "godot" },
        "requested_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "language": { "const": "gdscript" }
      }
    },
    "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "initialized": { "const": true } }, "required": ["initialized"] },
      "then": { "required": ["project_id", "schema_version", "revision", "mode", "engine", "updated_at"] }
    },
    {
      "if": { "properties": { "created": { "const": true } }, "required": ["created"] },
      "then": {
        "properties": {
          "initialized": { "const": true },
          "revision": { "const": 0 },
          "mode": { "const": "standard" },
          "engine": {
            "properties": {
              "kind": { "const": "godot" },
              "requested_version": { "const": "4.7.2-stable" },
              "language": { "const": "gdscript" }
            }
          }
        }
      }
    }
  ]
}
