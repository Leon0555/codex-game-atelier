{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-intent.schema.json",
  "title": "Codex Game Atelier immutable run intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "project_id", "project_revision", "policy_mode", "engine", "command", "started_at", "producer", "expected_result_ref", "declared_write_paths"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "run_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "project_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "project_revision": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "policy_mode": { "type": "string", "enum": ["manual", "standard", "strict"] },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requested_version", "language"],
      "properties": {
        "kind": { "const": "godot" },
        "requested_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "language": { "const": "gdscript" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "arguments"],
      "properties": {
        "name": { "type": "string", "enum": ["validate", "test", "build", "export", "release check"] },
        "arguments": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "type": "string", "minLength": 1, "maxLength": 128 },
          "additionalProperties": true
        }
      }
    },
    "started_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": { "const": "gameatelier-cli" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "expected_result_ref": { "$ref": "common.schema.json#/$defs/stateReference" },
    "declared_write_paths": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/relativePath" }
    },
    "declared_external_writes": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "const": "godot:user-data:standard-os-location" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "properties": { "name": { "const": "validate" } },
            "required": ["name"]
          }
        },
        "required": ["command"]
      },
      "then": {
        "properties": {
          "command": {
            "properties": {
              "arguments": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["project"],
                    "properties": { "project": { "const": "." } }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["project", "headless", "timeout_ms", "engine_user_data", "godot_source"],
                    "properties": {
                      "project": { "const": "." },
                      "headless": { "const": true },
                      "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 },
                      "engine_user_data": { "type": "string", "enum": ["not-authorized", "standard-os-location"] },
                      "godot_source": { "type": "string", "enum": ["explicit", "discovery"] }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "properties": { "name": { "const": "test" } },
            "required": ["name"]
          }
        },
        "required": ["command"]
      },
      "then": {
        "properties": {
          "command": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": ["project", "timeout_ms", "engine_user_data", "godot_source", "test_runner"],
                "properties": {
                  "project": { "const": "." },
                  "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 },
                  "engine_user_data": { "type": "string", "enum": ["not-authorized", "standard-os-location"] },
                  "godot_source": { "type": "string", "enum": ["explicit", "discovery"] },
                  "test_runner": { "const": "res://tests/atelier_test_runner.gd" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "properties": { "name": { "enum": ["export", "build"] } },
            "required": ["name"]
          }
        },
        "required": ["command"]
      },
      "then": {
        "properties": {
          "command": {
            "properties": {
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": ["project", "profile", "preset", "target", "timeout_ms", "engine_user_data", "godot_source"],
                "properties": {
                  "project": { "const": "." },
                  "profile": { "type": "string", "enum": ["debug", "release"] },
                  "preset": { "const": "macOS Technical" },
                  "target": { "const": "macos-universal2" },
                  "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 },
                  "engine_user_data": { "type": "string", "enum": ["not-authorized", "standard-os-location"] },
                  "godot_source": { "type": "string", "enum": ["explicit", "discovery"] }
                }
              }
            }
          },
          "declared_write_paths": {
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              { "type": "string", "pattern": "^\\.gameatelier/runs/atelier-[0-9]{8}t[0-9]{6}\\.[0-9]{9}z-[a-f0-9]{12}$" },
              { "type": "string", "pattern": "^\\.gameatelier/artifacts/atelier-[0-9]{8}t[0-9]{6}\\.[0-9]{9}z-[a-f0-9]{12}$" }
            ]
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "command": {
                "properties": {
                  "name": { "const": "validate" },
                  "arguments": {
                    "properties": {
                      "headless": { "const": true },
                      "engine_user_data": { "const": "standard-os-location" }
                    },
                    "required": ["headless", "engine_user_data"]
                  }
                },
                "required": ["name", "arguments"]
              }
            },
            "required": ["command"]
          },
          {
            "properties": {
              "command": {
                "properties": {
                  "name": { "const": "test" },
                  "arguments": {
                    "properties": { "engine_user_data": { "const": "standard-os-location" } },
                    "required": ["engine_user_data"]
                  }
                },
                "required": ["name", "arguments"]
              }
            },
            "required": ["command"]
          },
          {
            "properties": {
              "command": {
                "properties": {
                  "name": { "enum": ["export", "build"] },
                  "arguments": {
                    "properties": { "engine_user_data": { "const": "standard-os-location" } },
                    "required": ["engine_user_data"]
                  }
                },
                "required": ["name", "arguments"]
              }
            },
            "required": ["command"]
          }
        ]
      },
      "then": {
        "required": ["declared_external_writes"],
        "properties": {
          "declared_external_writes": {
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [{ "const": "godot:user-data:standard-os-location" }]
          }
        }
      },
      "else": {
        "properties": {
          "declared_external_writes": { "maxItems": 0 }
        }
      }
    }
  ]
}
