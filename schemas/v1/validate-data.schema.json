{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validate-data.schema.json",
  "title": "Codex Game Atelier validate data",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "check_count"],
      "properties": {
        "scope": { "type": "string", "enum": ["baseline", "headless"] },
        "check_count": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "recorded"],
      "properties": {
        "scope": { "type": "string", "enum": ["baseline", "headless"] },
        "recorded": { "const": false }
      }
    }
  ]
}
